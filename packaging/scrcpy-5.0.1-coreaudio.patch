+
+static bool
+sc_audio_player_send_all(struct sc_audio_player *ap, const uint8_t *data,
+                         size_t size) {
+    size_t sent = 0;
+    while (sent < size) {
+#ifdef MSG_NOSIGNAL
+        int flags = MSG_NOSIGNAL;
+#else
+        int flags = 0;
+#endif
+        ssize_t w = send(ap->socket_fd, data + sent, size - sent, flags);
+        if (w < 0) {
+            if (errno == EINTR) {
+                continue;
+            }
+            LOGE("PCM socket send failed: %s", strerror(errno));
+            return false;
+        }
+        if (w == 0) {
+            LOGE("PCM socket closed by receiver");
+            return false;
         }
+        sent += (size_t) w;
+    }
+    return true;
+}
+
+static void
+sc_audio_player_release(struct sc_audio_player *ap) {
+    if (ap->socket_fd >= 0) {
+        close(ap->socket_fd);
+        ap->socket_fd = -1;
+    }
+    swr_free(&ap->swr_ctx);
+    free(ap->swr_buf);
+    ap->swr_buf = NULL;
+    ap->swr_buf_size = 0;
+}
+
+static bool
+sc_audio_player_connect(struct sc_audio_player *ap, const char *path) {
+    size_t len = strlen(path);
+    if (len == 0 || len >= sizeof(((struct sockaddr_un *) 0)->sun_path)) {
+        LOGE("Invalid PCM socket path");
+        return false;
+    }
+
+    ap->socket_fd = socket(AF_UNIX, SOCK_STREAM, 0);
+    if (ap->socket_fd < 0) {
+        LOGE("Could not create PCM socket: %s", strerror(errno));
+        return false;
+    }
+    fcntl(ap->socket_fd, F_SETFD, FD_CLOEXEC);
+
+#ifdef SO_NOSIGPIPE
+    int enabled = 1;
+    if (setsockopt(ap->socket_fd, SOL_SOCKET, SO_NOSIGPIPE, &enabled,
+                   sizeof(enabled))) {
+        LOGE("Could not disable PCM socket SIGPIPE: %s", strerror(errno));
+        return false;
+    }
+#endif
+
+    struct sockaddr_un address;
+    memset(&address, 0, sizeof(address));
+    address.sun_family = AF_UNIX;
+#ifdef __APPLE__
+    address.sun_len = sizeof(address);
+#endif
+    memcpy(address.sun_path, path, len + 1);
+
+    int ret;
+    do {
+        ret = connect(ap->socket_fd, (const struct sockaddr *) &address,
+                      sizeof(address));
+    } while (ret < 0 && errno == EINTR);
+    if (ret < 0) {
+        LOGE("Could not connect PCM socket: %s", strerror(errno));
+        return false;
+    }
+    return true;
+}
+
+static bool
+sc_audio_player_reserve(struct sc_audio_player *ap, size_t size) {
+    if (size <= ap->swr_buf_size) {
+        return true;
+    }
+    uint8_t *buf = realloc(ap->swr_buf, size);
+    if (!buf) {
+        LOG_OOM();
+        return false;
     }
+    ap->swr_buf = buf;
+    ap->swr_buf_size = size;
+    return true;
 }
 
